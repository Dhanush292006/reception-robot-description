<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reception_robot">
  <!-- All dimensions are editable estimates based on the supplied photograph. SI units. -->
  <xacro:arg name="chassis_length" default="0.320"/>
  <xacro:arg name="chassis_width" default="0.280"/>
  <xacro:arg name="chassis_thickness" default="0.012"/>
  <xacro:arg name="wheel_radius" default="0.035"/>
  <xacro:arg name="wheel_width" default="0.025"/>
  <xacro:arg name="wheelbase" default="0.220"/>
  <xacro:arg name="wheel_separation" default="0.205"/>
  <xacro:arg name="motor_length" default="0.070"/>
  <xacro:arg name="motor_width" default="0.025"/>
  <xacro:arg name="motor_height" default="0.025"/>
  <xacro:arg name="battery_length" default="0.105"/>
  <xacro:arg name="battery_width" default="0.045"/>
  <xacro:arg name="battery_height" default="0.025"/>
  <xacro:arg name="display_mount_height" default="0.350"/>

  <xacro:property name="L" value="$(arg chassis_length)"/>
  <xacro:property name="W" value="$(arg chassis_width)"/>
  <xacro:property name="T" value="$(arg chassis_thickness)"/>
  <xacro:property name="R" value="$(arg wheel_radius)"/>
  <xacro:property name="WW" value="$(arg wheel_width)"/>
  <xacro:property name="WB" value="$(arg wheelbase)"/>
  <xacro:property name="WS" value="$(arg wheel_separation)"/>
  <!-- base_link is chassis center; ground is z=-R. -->
  <!-- TF-only ground reference frame, intentionally has no physical inertia. -->
  <link name="base_footprint"/>
  <link name="base_link">
    <inertial><mass value="1.20"/><origin xyz="0 0 0"/><inertia ixx="0.0080" ixy="0" ixz="0" iyy="0.0110" iyz="0" izz="0.0180"/></inertial>
    <visual><geometry><box size="${L} ${W} ${T}"/></geometry><material name="aluminum"><color rgba="0.72 0.73 0.75 1"/></material></visual>
    <collision><geometry><box size="${L} ${W} ${T}"/></geometry></collision>
  </link>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 ${R + T/2}" rpy="0 0 0"/></joint>

  <xacro:macro name="box_component" params="name x y z sx sy sz mass color">
    <link name="${name}">
      <inertial><mass value="${mass}"/><origin xyz="0 0 0"/><inertia ixx="${mass*(sy*sy+sz*sz)/12}" ixy="0" ixz="0" iyy="${mass*(sx*sx+sz*sz)/12}" iyz="0" izz="${mass*(sx*sx+sy*sy)/12}"/></inertial>
      <visual><geometry><box size="${sx} ${sy} ${sz}"/></geometry><material name="${name}_mat"><color rgba="${color}"/></material></visual>
      <collision><geometry><box size="${sx} ${sy} ${sz}"/></geometry></collision>
    </link>
    <joint name="${name}_mount" type="fixed"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} ${y} ${z}"/></joint>
  </xacro:macro>
  <!-- Estimated component envelopes; the photo does not establish scale or mass. -->
  <xacro:box_component name="front_left_motor" x="${WB/2-0.035}" y="${WS/2-0.020}" z="${-R+0.045}" sx="$(arg motor_length)" sy="$(arg motor_width)" sz="$(arg motor_height)" mass="0.080" color="0.95 0.75 0.05 1"/>
  <xacro:box_component name="front_right_motor" x="${WB/2-0.035}" y="${-WS/2+0.020}" z="${-R+0.045}" sx="$(arg motor_length)" sy="$(arg motor_width)" sz="$(arg motor_height)" mass="0.080" color="0.95 0.75 0.05 1"/>
  <xacro:box_component name="rear_left_motor" x="${-WB/2+0.035}" y="${WS/2-0.020}" z="${-R+0.045}" sx="$(arg motor_length)" sy="$(arg motor_width)" sz="$(arg motor_height)" mass="0.080" color="0.95 0.75 0.05 1"/>
  <xacro:box_component name="rear_right_motor" x="${-WB/2+0.035}" y="${-WS/2+0.020}" z="${-R+0.045}" sx="$(arg motor_length)" sy="$(arg motor_width)" sz="$(arg motor_height)" mass="0.080" color="0.95 0.75 0.05 1"/>
  <xacro:box_component name="battery_pack" x="0" y="0" z="${T/2+0.018}" sx="$(arg battery_length)" sy="$(arg battery_width)" sz="$(arg battery_height)" mass="0.180" color="0.30 0.18 0.38 1"/>
  <xacro:box_component name="esp32_board" x="-0.035" y="0.060" z="${T/2+0.012}" sx="0.055" sy="0.028" sz="0.006" mass="0.015" color="0.08 0.12 0.16 1"/>
  <xacro:box_component name="l298n_driver" x="0.035" y="0" z="${T/2+0.012}" sx="0.060" sy="0.045" sz="0.012" mass="0.035" color="0.75 0.12 0.08 1"/>
  <!-- Configurable frame for a future portrait display; the display itself is omitted. -->
  <link name="display_mount"><inertial><mass value="0.001"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial></link>
  <joint name="display_mount_joint" type="fixed"><parent link="base_link"/><child link="display_mount"/><origin xyz="0 0 $(arg display_mount_height)" rpy="0 0 0"/></joint>

  <!-- Wheel-cylinder axis is local Z rotated to robot Y; joint axis is robot Y. -->
  <xacro:macro name="wheel_roller_visual" params="wheel idx roller_sign">
    <xacro:property name="a" value="${idx*0.78539816339}"/>
    <visual name="${wheel}_roller_visual_${idx}">
      <origin xyz="${R*cos(a)} 0 ${R*sin(a)}" rpy="${roller_sign*0.78539816339} 0 ${-a}"/>
      <geometry><cylinder radius="${R*0.22}" length="${WW*0.62}"/></geometry>
      <material name="roller_black"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
  </xacro:macro>
  <xacro:macro name="mecanum_wheel" params="name x y roller_sign">
    <link name="${name}_link">
      <inertial><mass value="0.055"/><origin xyz="0 0 0"/><inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000040" iyz="0" izz="0.000025"/></inertial>
      <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${R}" length="${WW}"/></geometry><material name="wheel_yellow"><color rgba="0.98 0.68 0.03 1"/></material></visual>
      <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${R}" length="${WW}"/></geometry></collision>
      <!-- Eight angled black roller visuals on the yellow wheel body. -->
      <xacro:wheel_roller_visual wheel="${name}" idx="0" roller_sign="${roller_sign}"/>
      <xacro:wheel_roller_visual wheel="${name}" idx="1" roller_sign="${roller_sign}"/>
      <xacro:wheel_roller_visual wheel="${name}" idx="2" roller_sign="${roller_sign}"/>
      <xacro:wheel_roller_visual wheel="${name}" idx="3" roller_sign="${roller_sign}"/>
      <xacro:wheel_roller_visual wheel="${name}" idx="4" roller_sign="${roller_sign}"/>
      <xacro:wheel_roller_visual wheel="${name}" idx="5" roller_sign="${roller_sign}"/>
      <xacro:wheel_roller_visual wheel="${name}" idx="6" roller_sign="${roller_sign}"/>
      <xacro:wheel_roller_visual wheel="${name}" idx="7" roller_sign="${roller_sign}"/>
    </link>
    <joint name="${name}_joint" type="continuous"><parent link="base_link"/><child link="${name}_link"/><origin xyz="${x} ${y} ${-T/2}"/><axis xyz="0 1 0"/><limit effort="10" velocity="30"/><dynamics damping="0.02" friction="0.01"/></joint>
  </xacro:macro>
  <!-- X forward, Y left; standard X roller slope on FL/RR, opposite on FR/RL. -->
  <xacro:mecanum_wheel name="front_left_wheel" x="${WB/2}" y="${WS/2}" roller_sign="1"/>
  <xacro:mecanum_wheel name="front_right_wheel" x="${WB/2}" y="${-WS/2}" roller_sign="-1"/>
  <xacro:mecanum_wheel name="rear_left_wheel" x="${-WB/2}" y="${WS/2}" roller_sign="-1"/>
  <xacro:mecanum_wheel name="rear_right_wheel" x="${-WB/2}" y="${-WS/2}" roller_sign="1"/>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>${WS}</wheel_separation>
      <wheelbase>${WB}</wheelbase>
      <wheel_radius>${R}</wheel_radius>
      <min_linear_acceleration>-1.5</min_linear_acceleration><max_linear_acceleration>1.5</max_linear_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration><max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </gazebo>
  <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="front_left_wheel_link"><mu1>0.8</mu1><mu2>0.8</mu2><kp>100000</kp><kd>1</kd></gazebo>
  <gazebo reference="front_right_wheel_link"><mu1>0.8</mu1><mu2>0.8</mu2><kp>100000</kp><kd>1</kd></gazebo>
  <gazebo reference="rear_left_wheel_link"><mu1>0.8</mu1><mu2>0.8</mu2><kp>100000</kp><kd>1</kd></gazebo>
  <gazebo reference="rear_right_wheel_link"><mu1>0.8</mu1><mu2>0.8</mu2><kp>100000</kp><kd>1</kd></gazebo>
</robot>
